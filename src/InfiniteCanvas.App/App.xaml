<Application x:Class="InfiniteCanvas.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111418" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A2026" />
        <SolidColorBrush x:Key="BorderBrush" Color="#313A43" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F7F8" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAB6BD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#35D0BA" />
    </Application.Resources>
</Application>
