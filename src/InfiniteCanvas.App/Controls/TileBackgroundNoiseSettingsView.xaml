<UserControl x:Class="InfiniteCanvas.App.Controls.TileBackgroundNoiseSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="220"
             d:DesignHeight="180">
    <Border Padding="8" Background="#151A20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="TILE BACKGROUND NOISE" FontFamily="Cascadia Mono" FontSize="11"
                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Target value" Margin="0,8,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Slider Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding TargetValue, Mode=TwoWay}" />
            <TextBlock Text="Noise amplitude" Margin="0,8,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding Noise, Mode=TwoWay}" />
            <TextBlock Text="Defect circles" Margin="0,8,0,4" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Slider Minimum="0" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding CircleCount, Mode=TwoWay}" />
        </StackPanel>
    </Border>
</UserControl>
