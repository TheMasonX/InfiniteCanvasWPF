<Window x:Class="InfiniteCanvas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:InfiniteCanvas.App.Controls"
        mc:Ignorable="d"
        Title="Infinite Canvas" Width="1600" Height="1024"
        MinWidth="760" MinHeight="520"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="90*" />
            <RowDefinition Height="10*"/>
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INFINITE CANVAS" FontFamily="Cascadia Mono"
                               FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VISIBLE" Margin="0,0,8,0" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding VisibleItemCount, StringFormat=N0}" MinWidth="72"
                               FontFamily="Cascadia Mono" FontSize="18" FontWeight="SemiBold" />
                    <Border Width="1" Height="28" Margin="18,0" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="TOTAL" Margin="0,0,8,0" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalItemCount, StringFormat=N0}" MinWidth="72"
                               FontFamily="Cascadia Mono" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="280" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ViewportHost" Grid.Column="0"
                    Background="#080B0D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    ClipToBounds="True"
                    MouseLeftButtonDown="OnViewportMouseLeftButtonDown"
                    MouseLeftButtonUp="OnViewportMouseLeftButtonUp"
                    MouseRightButtonDown="OnViewportMouseRightButtonDown"
                    MouseRightButtonUp="OnViewportMouseRightButtonUp"
                    MouseMove="OnViewportMouseMove"
                    MouseLeave="OnViewportMouseLeave"
                    MouseWheel="OnViewportMouseWheel"
                    SizeChanged="OnViewportSizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="17*"/>
                        <RowDefinition Height="925*"/>
                    </Grid.RowDefinitions>
                    <Viewbox x:Name="FramePresenter" Stretch="Fill" StretchDirection="Both" Grid.RowSpan="2" />
                        <Canvas x:Name="ViewportScrollbarOverlay" Grid.RowSpan="2" IsHitTestVisible="True">
                        <Border x:Name="HorizontalScrollbarTrack" Width="120" Height="10"
                            Background="#664B5563" CornerRadius="5"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="OnScrollbarTrackMouseLeftButtonDown" />
                        <Border x:Name="HorizontalScrollbarThumb" Width="48" Height="10"
                            Background="#FFB7C0D9" CornerRadius="5"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="OnScrollbarThumbMouseLeftButtonDown"
                            MouseMove="OnScrollbarThumbMouseMove"
                            MouseLeftButtonUp="OnScrollbarThumbMouseLeftButtonUp" />
                        <Border x:Name="VerticalScrollbarTrack" Width="10" Height="120"
                            Background="#664B5563" CornerRadius="5"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="OnScrollbarTrackMouseLeftButtonDown" />
                        <Border x:Name="VerticalScrollbarThumb" Width="10" Height="48"
                            Background="#FFB7C0D9" CornerRadius="5"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="OnScrollbarThumbMouseLeftButtonDown"
                            MouseMove="OnScrollbarThumbMouseMove"
                            MouseLeftButtonUp="OnScrollbarThumbMouseLeftButtonUp" />
                        </Canvas>
                    <Canvas IsHitTestVisible="False" Grid.RowSpan="2">
                        <Ellipse x:Name="PanAnchorVisual"
                                 Width="16" Height="16"
                                 Stroke="#D7FF3D3D" StrokeThickness="2"
                                 Fill="#40FF3D3D"
                                 Visibility="Collapsed" />
                    </Canvas>
                    <TextBlock x:Name="LoadingOverlay" Text="BUILDING INITIAL SNAPSHOT"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               FontFamily="Cascadia Mono" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,446,0,0" Grid.Row="1" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,0,0,14"
                            Padding="10,7" Background="#DD1A2026"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Grid.Row="1">
                        <StackPanel>
                            <TextBlock x:Name="PixelometerWorldText" Text="WORLD X --  Y --"
                                       FontFamily="Cascadia Mono" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="PixelometerTileText" Text="TILE --"
                                       FontFamily="Cascadia Mono" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="PixelometerValueText" Text="PIXEL --"
                                       FontFamily="Cascadia Mono" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                    <ProgressBar Grid.Row="3" x:Name="RenderBusyBar" Height="2" IsIndeterminate="True" Visibility="Collapsed" d:Visibility="Visible"
                             VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="6">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="DISPLAY OPTIONS" FontFamily="Cascadia Mono" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Zoom" Margin="0,10,0,4" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="ZoomPresetComboBox" IsEditable="True" IsReadOnly="True" Text="100%"
                                  SelectionChanged="OnZoomPresetSelectionChanged">
                            <ComboBoxItem Content="Fit To Width" />
                            <ComboBoxItem Content="Fit To Height" />
                            <ComboBoxItem Content="50%" />
                            <ComboBoxItem Content="75%" />
                            <ComboBoxItem Content="100%" />
                            <ComboBoxItem Content="150%" />
                            <ComboBoxItem Content="200%" />
                            <ComboBoxItem Content="Custom..." />
                        </ComboBox>
                        <Grid x:Name="CustomZoomPanel" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomZoomTextBox" Text="100" ToolTip="Custom zoom percentage"
                                     KeyDown="OnCustomZoomKeyDown" />
                            <Button Grid.Column="2" Content="Apply" MinWidth="58" Click="OnCustomZoomClicked" />
                        </Grid>

                        <TextBlock Text="Annotation mode" Margin="0,10,0,4" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="DisplayModeComboBox" SelectedIndex="0"
                                  SelectionChanged="OnDisplayModeSelectionChanged">
                            <ComboBoxItem Content="Outline" />
                            <ComboBoxItem Content="Fill" />
                            <ComboBoxItem Content="OutlineAndFill" />
                        </ComboBox>

                        <TextBlock Text="Outline thickness" Margin="0,10,0,4" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="6" Value="2" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" ValueChanged="OnOutlineThicknessChanged" />

                        <TextBlock Text="Label size" Margin="0,10,0,4" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Slider x:Name="LabelSizeSlider" Minimum="8" Maximum="20" Value="8.5" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" ValueChanged="OnLabelSizeChanged" />

                        <TextBlock Text="Label content" Margin="0,10,0,4" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="LabelDisplayComboBox" SelectedIndex="0"
                              SelectionChanged="OnLabelDisplaySelectionChanged">
                            <ComboBoxItem Content="Class" />
                            <ComboBoxItem Content="ID" />
                        </ComboBox>

                        <CheckBox x:Name="ShowLabelsCheckBox" Content="Show labels" IsChecked="True"
                                  Margin="0,8,0,0" Checked="OnShowLabelsChanged" Unchecked="OnShowLabelsChanged" />

                        <CheckBox x:Name="ShowImageTilesCheckBox" Content="Show image tiles" IsChecked="True"
                                  Margin="0,8,0,0" Checked="OnShowImageTilesChanged" Unchecked="OnShowImageTilesChanged" />

                        <CheckBox x:Name="ShowBackgroundImagesCheckBox" Content="Show background images" IsChecked="True"
                                  Margin="0,8,0,0" Checked="OnShowBackgroundImagesChanged" Unchecked="OnShowBackgroundImagesChanged" />

                        <controls:TileBackgroundNoiseSettingsView Margin="0,12,0,0"
                                                                  ViewModel="{Binding DataContext.TileBackgroundNoiseSettings, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <Border Height="1" Margin="0,14,0,12" Background="{StaticResource BorderBrush}" />

                        <Expander Padding="8" Margin="0,12,0,0"
                                  Background="#151A20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Expander.Header>
                                <TextBlock Text="SCENE MATERIAL" FontFamily="Cascadia Mono" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Expander.Header>
                            <StackPanel>
                                <controls:SliderTextBox x:Name="TilesXSliderTextBox" Label="Tiles X"
                                                        Minimum="1" Maximum="2000" TickFrequency="1"
                                                        NumericType="Integer" Value="2" />
                                <controls:SliderTextBox x:Name="TilesYSliderTextBox" Label="Tiles Y"
                                                        Minimum="1" Maximum="2000" TickFrequency="1"
                                                        NumericType="Integer" Value="32" />
                                <controls:SliderTextBox x:Name="ObjectsPerTileSliderTextBox" Label="Objects per tile"
                                                        Minimum="0" Maximum="256" TickFrequency="1"
                                                        NumericType="Integer" Value="16" />
                                <controls:SliderTextBox x:Name="GenerationSeedSliderTextBox" Label="Generation seed"
                                                        Minimum="0" Maximum="2147483647" TickFrequency="1"
                                                        NumericType="Integer" ShowSlider="False" Value="1729" />
                            </StackPanel>
                        </Expander>

                        <Grid x:Name="ButtonGrid" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" x:Name="RegenerateButton" Content="Regenerate" Height="30" Click="OnRegenerateClicked" />
                            <Button Grid.Column="3" x:Name="DebugDumpCacheButton" Content="Reset Cache" Height="30" Click="OnDebugDumpCacheClicked" />
                        </Grid>
                        <TextBlock x:Name="CacheStatusText" Margin="0,8,0,0" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

                        <TextBlock Text="FEATURES" Margin="0,10,0,4" FontFamily="Cascadia Mono" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <DataGrid x:Name="FeatureDataGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                  BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="#111418"
                                  Height="180" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedAnnotationFeatures}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" MinWidth="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Grid.RowSpan="2">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontFamily="Cascadia Mono"
                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="SceneSummaryText" Text="64 TILE INSPECTION SCENE (2 x 32)" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
